# Chuyển tiếp lead từ form về CRM (bắt buộc khi lên production)
# Điền endpoint webhook nhận lead của CRM đang dùng (Getfly / MISA AMIS / HubSpot / Zoho / tự dựng...)
CRM_WEBHOOK_URL=

# (Tuỳ chọn) API key nếu CRM yêu cầu xác thực — gửi dạng "Authorization: Bearer <key>"
CRM_API_KEY=

# (P1 — tự động tạo model 3D tượng điêu khắc bằng AI, xem PRD mục 4.2)
MESHY_API_KEY=
