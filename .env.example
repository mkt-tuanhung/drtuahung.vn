# ===== Hoặc webhook CRM tuỳ ý (dự phòng, bỏ trống nếu dùng Supabase) =====
CRM_WEBHOOK_URL=
CRM_API_KEY=

# (P1 — tự động tạo model 3D bằng AI, xem PRD mục 4.2)
MESHY_API_KEY=
